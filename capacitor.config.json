{
  "appId": "com.bglmautam.app",
  "appName": "Điểm Danh",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "errorPath": "webview-old.html"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 80
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    }
  }
}