<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules): KHÔNG sao lưu lên Google Drive (cloud-backup loại hết);
     chuyển máy trực tiếp (cáp / Wi-Fi, device-transfer) thì vẫn mang theo ảnh + cài đặt để GLV đổi điện thoại không mất ảnh -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
